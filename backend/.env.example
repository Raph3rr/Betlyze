MONGODB_URI=paste-your-atlas-connection-string-here
JWT_SECRET=paste-a-long-random-string-here
PORT=5000
# The address of your frontend (no trailing slash). In production use your real domain or Vercel address.
FRONTEND_URL=http://localhost:5173

# Football data (API-Football / API-Sports dashboard)
API_FOOTBALL_KEY=
# Odds (OddsPapi account settings)
ODDSPAPI_KEY=
# Used later for the AI analysis (Google AI Studio)
GEMINI_API_KEY=
# Model your key will call. Run npm run check-keys to see which models your key can use.
GEMINI_MODEL=gemini-3.5-flash
# Only used by npm run sample (any bookmaker name from the OddsPapi list)
ODDS_BOOKMAKER=pinnacle
