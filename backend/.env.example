MONGODB_URI=paste-your-atlas-connection-string-here
JWT_SECRET=paste-a-long-random-string-here
PORT=5000
# The address of your frontend (no trailing slash). In production use your real domain or Vercel address.
FRONTEND_URL=http://localhost:5173

# Football data (API-Football / API-Sports dashboard)
API_FOOTBALL_KEY=
# Odds (OddsPapi account settings)
ODDSPAPI_KEY=
# Used later for the AI analysis (Google AI Studio)
GEMINI_API_KEY=
# Model your key will call. Run npm run check-keys to see which models your key can use.
GEMINI_MODEL=gemini-3.5-flash
# Whose prices we show (OddsPapi slug). 1xbet works; sportybet and msport returned no fixtures.
ODDS_BOOKMAKER=1xbet
# Free API-Football plan allows 10 requests a minute. Set to 0 on a paid plan.
API_FOOTBALL_MIN_INTERVAL_MS=6500
# Stops one run using more than this many API-Football requests (free plan allows 100 a day)
API_FOOTBALL_BUDGET=90
# true = also fetch each team's last 5 games for game-by-game stats (2 extra requests per fixture: needs a paid API-Football plan)
RECENT_GAMES=false
# true = also read each team's last 2 lineups (formation, how many starters changed). Costs about 6 requests per fixture: needs a paid plan.
LINEUPS=false
# Most fixtures analysed per day
MAX_FIXTURES_PER_DAY=20
# A long random string. The daily scheduler sends it in the x-cron-secret header.
CRON_SECRET=
# Only if you see 'querySrv ETIMEOUT' or 'ECONNREFUSED' when connecting to MongoDB: use public DNS servers
# DNS_SERVERS=8.8.8.8,1.1.1.1
